{
  "name": "@nila/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "api:start": "bun run src/index.ts",
    "api:dev": "bun --watch --env-file=.env run src/index.ts",
    "api:spec&client": "bun src/utils/openapi-document.ts && bun openapi-ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.3",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@golevelup/nestjs-stripe": "^0.9.3",
    "@google-cloud/storage": "^7.16.0",
    "@highlight-run/nest": "^3.6.26",
    "@nest-lab/fastify-multer": "^1.3.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@scalar/nestjs-api-reference": "^0.5.5",
    "@sinclair/typebox": "^0.34.36",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.44.2",
    "drizzle-typebox": "^0.3.3",
    "fast-jwt": "^6.0.2",
    "mailersend": "^2.6.0",
    "nestjs-pino": "^4.4.0",
    "nestjs-typebox": "^4.0.0",
    "pg": "^8.16.2",
    "pino-pretty": "^13.0.0",
    "stripe": "^18.2.1"
  },
  "devDependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.76.0",
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.15.4",
    "bun-types": "^1.2.17",
    "drizzle-kit": "^0.31.2",
    "drizzle-seed": "^0.3.1",
    "typescript": "^5.8.3"
  }
